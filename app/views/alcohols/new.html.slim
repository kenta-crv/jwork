- set_meta_tags noindex: true
.tops-wrapper
   h2.headline  アルコールチェックシート
   = form_for([@user, @alcohol]) do |f| 
    table.company
     colgroup
      col width="20%"
      col width="20%"
      col width="60%"
     tbody
      tr
          td
            strong.label 必須
          td.arrow_box
            | 勤務日
          td.center
            = f.date_field :post, class: "form-control"

      tr
          td
            strong.label 必須
          td.arrow_box
            | 本日のアルコール値は基準以下でしたか？
          td.center
            = f.select :check, [['はい', 'はい'], ['いいえ（担当者に連絡してください）', 'いいえ（担当者に連絡してください）']], { include_blank: '選択してください' }
      tr
          td
            strong.label 必須
          td.arrow_box
            | 健康状態に問題はありませんか？
          td.center
            = f.select :health, [['はい', 'はい'], ['いいえ（担当者に連絡してください）', 'いいえ（担当者に連絡してください）']], { include_blank: '選択してください' }
      tr
        td.center[colspan="3"]= f.submit "登録する"
