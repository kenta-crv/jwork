  header.jf-header
    .jf-container.jf-header__inner
      = link_to '/', class: 'jf-brand', aria: { label: 'J Work トップへ' } do
        = image_tag 'rogo.webp', alt: 'J Work', class: 'jf-brand__logo', width: '150', height: '54'

      nav.jf-nav aria-label="メインナビゲーション"
        = link_to 'お悩み', '#service', class: 'jf-nav__link'
        = link_to '選ばれる理由', '#features', class: 'jf-nav__link'
        = link_to '料金の目安', '#price', class: 'jf-nav__link'
        = link_to 'よくあるご質問', '#faq', class: 'jf-nav__link'
        = link_to 'ご利用の流れ', '#flow', class: 'jf-nav__link'

      button.jf-contact-button.jf-contact-button--header type="button" data-open-contact="true"
        span.jf-contact-button__icon aria-hidden="true"
          svg.jf-ico
            use href="#jf-i-mail"
        span.jf-contact-button__copy
          strong メールで依頼する
          small 情報を入力

  main
    section#top.jf-hero
      .jf-hero__image aria-hidden="true" style="--jf-hero-image: url(#{asset_path('hero-foreign-workers.jpg')})"
      .jf-container.jf-hero__inner
        .jf-hero__content
          p.jf-hero__eyebrow 圧倒的な人材力で、企業を支える。
          h1.jf-hero__title
            | 外国人材を活用なら
            br
            | J Workに
            em お任せ！
          p.jf-hero__lead 必要な外国人材を、全国の現場へ継続して斡旋します。

          ul.jf-hero__points
            li.jf-round-point
              span.jf-line-icon aria-hidden="true"
                svg.jf-ico
                  use href="#jf-i-building"
              strong 登録者4,000名
              b 毎月500名登録
            li.jf-round-point
              span.jf-line-icon aria-hidden="true"
                svg.jf-ico
                  use href="#jf-i-calendar"
              strong 就労制限のない
              b 永住ビザ中心
            li.jf-round-point
              span.jf-line-icon aria-hidden="true"
                svg.jf-ico
                  use href="#jf-i-heart-person"
              strong 深夜・早朝も
              b 柔軟に手配

    section#service.jf-concerns.jf-section
      .jf-container
        h2.jf-section-title
          | こんな
          em お悩み
          | はありませんか？

        .jf-concerns__grid
          article.jf-concern-card
            span.jf-concern-card__icon aria-hidden="true"
              svg.jf-ico
                use href="#jf-i-worry"
            p
              | 求人掲載から応募が来ず、
              br
              | 現場が回らない
          article.jf-concern-card
            span.jf-concern-card__icon aria-hidden="true"
              svg.jf-ico
                use href="#jf-i-crossed"
            p
              | 採用しても定着せず、
              br
              | 人員が安定しない
          article.jf-concern-card
            span.jf-concern-card__icon aria-hidden="true"
              svg.jf-ico
                use href="#jf-i-building"
            p
              | 欠員が続き、
              br
              | シフトが安定しない
          article.jf-concern-card
            span.jf-concern-card__icon aria-hidden="true"
              svg.jf-ico
                use href="#jf-i-calc"
            p
              | コストを抑えつつ
              br
              | 継続して人材を確保したい

        span.jf-concerns__arrow aria-hidden="true"

        .jf-concerns__answer
          .jf-concerns__content
            .jf-concerns__headline
              span.jf-concerns__lead そのお悩み、
              span.jf-concerns__badge 外国人材の斡旋
            .jf-concerns__brand-row
              span.jf-concerns__mark aria-hidden="true"
                svg.jf-ico
                  use href="#jf-i-people"
              strong.jf-concerns__brand J Work
              span.jf-concerns__suffix がすべて
              em.jf-concerns__solve 解決
              span.jf-concerns__suffix します。
          .jf-concerns__visual
            .jf-concerns__visual-frame
              = image_tag 'feature-team.jpg', alt: '', class: 'jf-concerns__visual-img'
            span.jf-concerns__deco.jf-concerns__deco--sparkle aria-hidden="true"
              svg viewBox="0 0 24 24" fill="currentColor"
                path d="M12 0l3 9 9 3-9 3-3 9-3-9-9-3 9-3z"
            span.jf-concerns__deco.jf-concerns__deco--chat aria-hidden="true"
              svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"
            span.jf-concerns__deco.jf-concerns__deco--chart aria-hidden="true"
              svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"
                line x1="18" y1="20" x2="18" y2="10"
                line x1="12" y1="20" x2="12" y2="4"
                line x1="6" y1="20" x2="6" y2="14"



    section#scope.jf-scope
      .jf-scope__people.jf-scope__people--left
        = image_tag 'jf-scope-people-left.png', alt: '', class: 'jf-scope__people-img'
    
      .jf-scope__people.jf-scope__people--right
        = image_tag 'jf-scope-people-right.png', alt: '', class: 'jf-scope__people-img'
    
      p.jf-scope__hand.jf-scope__hand--left 多様な人材が現場の力になります。
    
      p.jf-scope__hand.jf-scope__hand--right-top
        | はたらく
        br    
        | を、つなぐ。
    
      p.jf-scope__hand.jf-scope__hand--right-mid
        | 国籍をこえて
        br
        | ともに働く
        br
        | 明るい職場を。
    
      p.jf-scope__hand.jf-scope__hand--right-bottom
        | 人がつながり、
        br
        | 現場が動き出す。
    
      .jf-container.jf-scope__inner
        p.jf-scope__brand
          span.jf-scope__brand-rule —
          | J WORK
          span.jf-scope__brand-rule —
    
        p.jf-scope__tag つながると、広がる未来へ
    
        h2.jf-scope__title 受付可能範囲
    
        p.jf-scope__lead 日本語で会話ができる外国人材を、現場業務を中心にご紹介。
    
        .jf-scope__card
          .jf-scope__cols
            article.jf-scope__col
              h3.jf-scope__col-head.jf-scope__col-head--ok
                span.jf-scope__col-mark aria-hidden="true" ✓
                | 対応する業務
    
              ul.jf-scope__list
                li
                  span.jf-scope__icon-wrap
                    = image_tag 'jf-scope-warehouse.png', alt: '', class: 'jf-scope__icon'
                  span 漢字の読み書きを必須としない業務
                li
                  span.jf-scope__icon-wrap
                    = image_tag 'jf-scope-talk.png', alt: '', class: 'jf-scope__icon'
                  span 日本語での会話を中心に進められるブルーワーク業務

            article.jf-scope__col
              h3.jf-scope__col-head.jf-scope__col-head--ng
                span.jf-scope__col-mark aria-hidden="true" ×
                | 対象外の条件
    
              ul.jf-scope__list
                li
                  span.jf-scope__icon-wrap
                    = image_tag 'jf-scope-kanji.png', alt: '', class: 'jf-scope__icon'
                  span 日本人レベルの漢字能力を求める業務
    
                li
                  span.jf-scope__icon-wrap
                    = image_tag 'jf-scope-office.png', alt: '', class: 'jf-scope__icon'
                  span ビジネス日本語を使うホワイトカラー業務
    
          .jf-scope__note
            span.jf-scope__note-icon aria-hidden="true"
            p
              | 採用率が低い案件、最終面接が2回以上の選考のお受付は承っておりません。
    
        p.jf-scope__foot
          | J WORK
          span ともに、はたらく社会をつくる



    section#features.jf-features.jf-section
      .jf-container
        p.jf-section-kicker 人材力で、現場を支える。
        h2.jf-heading
          | J Workが
          em 選ばれる
          | 理由
        p.jf-heading-lead 常時約4,000名の人材力で、全国の現場へ継続して斡旋します。

        .jf-features__grid
          article.jf-feature-card
            .jf-feature-card__body
              .jf-feature-card__meta
                span.jf-feature-card__icon aria-hidden="true"
                  svg.jf-ico
                    use href="#jf-i-sparkle"
                span.jf-feature-card__number 01
              h3 圧倒的な人材規模
              p 毎月アクティブ登録者約4,000名・新規登録約500名。幅広い現場に対応できる人材プールから、安定してスタッフを斡旋します。
            = image_tag 'feature-retention.jpg', class: 'jf-feature-card__image', alt: '多数の外国人材スタッフ', loading: 'lazy'
          article.jf-feature-card
            .jf-feature-card__body
              .jf-feature-card__meta
                span.jf-feature-card__icon aria-hidden="true"
                  svg.jf-ico
                    use href="#jf-i-team"
                span.jf-feature-card__number 02
              h3 精度の高い人材手配
              p 外国人材はビザのミスマッチを防ぐため、当社で一次面接を済ませた人材をご紹介します。
            = image_tag 'feature-matching.jpg', class: 'jf-feature-card__image', alt: '一次面接で人材を確認', loading: 'lazy'
          article.jf-feature-card
            .jf-feature-card__body
              .jf-feature-card__meta
                span.jf-feature-card__icon aria-hidden="true"
                  svg.jf-ico
                    use href="#jf-i-shield"
                span.jf-feature-card__number 03
              h3 全国対応・深夜にも強い
              p 全国の現場に対応。早朝・深夜の勤務も、速やかに人材を斡旋できます。
            = image_tag 'feature-training.jpg', class: 'jf-feature-card__image', alt: '深夜帯の現場で作業するスタッフ', loading: 'lazy'

    section#price.jf-price.jf-section
      .jf-container
        p.jf-section-kicker わかりやすく、安心の料金プラン
        h2.jf-heading
          em 料金
          | のご案内
        p.jf-heading-lead 1日4時間・週2回からサービスをご利用いただけます

        h3.jf-subheading 選べる3つの料金プラン
        .jf-price__controls
          label.jf-price__pref-label for="jf-pref-select"
            span 都道府県を選択
            select#jf-pref-select.jf-price__pref-select
              option value="" selected="selected" 全国（最安値）
          p.jf-price__base
            span.jf-price__campaign キャンペーン価格
            span.jf-price__base-copy
              | ベースは最安値で
              s#jf-price-base-list —
              strong#jf-price-base-amount —
              | 円〜
            small#jf-price-base-note （全国）

        #jf-price-plans
          .jf-price__grid#jf-price-grid
            article.jf-price-card data-plan="light" data-plan-extra="1400"
