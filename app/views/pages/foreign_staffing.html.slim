  javascript:
    (function () {
      var header = document.querySelector('.jw-foreign-lp .jf-header');
      if (!header) return;
      var ticking = false;
      function shouldShow() {
        return window.scrollY > 80;
      }
      function update() {
        header.classList.toggle('is-visible', shouldShow());
      }
      function onScroll() {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(function () {
          ticking = false;
          update();
        });
      }
      update();
      window.addEventListener('scroll', onScroll, { passive: true });
      header.addEventListener('click', function (e) {
        var a = e.target.closest('a[href^="#"]');
        if (!a) return;
        var id = (a.getAttribute('href') || '').slice(1);
        if (!id) return;
        var target = document.getElementById(id);
        if (!target) return;
        e.preventDefault();
        if (history.replaceState) history.replaceState(null, '', '#' + id);
        if (id === 'top') {
          window.scrollTo({ top: 0, behavior: 'smooth' });
        } else {
          target.scrollIntoView({ behavior: 'smooth' });
        }
      });
    })();

    (function () {
      var modal = document.getElementById('contact-modal');
      if (!modal) return;
      function openModal(e) {
        if (e) e.preventDefault();
        if (typeof modal.showModal === 'function') modal.showModal();
        else modal.setAttribute('open', '');
      }
      function closeModal() {
        if (typeof modal.close === 'function') modal.close();
        else modal.removeAttribute('open');
      }
      document.querySelectorAll('[data-open-contact]').forEach(function (el) {
        el.addEventListener('click', openModal);
      });
      var closeBtn = modal.querySelector('[data-close-contact]');
      if (closeBtn) closeBtn.addEventListener('click', closeModal);
      modal.addEventListener('click', function (e) {
        if (e.target === modal) closeModal();
      });
      if (#{(params[:error].to_s == '1' || params[:sent].to_s == '1').to_json}) openModal();
      document.querySelectorAll('.jf-pick').forEach(function (pick) {
        var btn = pick.querySelector('.jf-pick__btn');
        var list = pick.querySelector('.jf-pick__list');
        var input = pick.querySelector('input');
        var valueEl = pick.querySelector('.jf-pick__value');
        if (!btn || !list || !input || !valueEl) return;
        btn.addEventListener('click', function (e) {
          e.stopPropagation();
          document.querySelectorAll('.jf-pick.is-open').forEach(function (other) {
            if (other !== pick) other.classList.remove('is-open');
          });
          pick.classList.toggle('is-open');
        });
        list.addEventListener('click', function (e) { e.stopPropagation(); });
        list.querySelectorAll('.jf-pick__item').forEach(function (item) {
          item.addEventListener('click', function (e) {
            e.preventDefault();
            if (item.classList.contains('jf-pick__item--off')) return;
            var text = item.childNodes[0] ? item.childNodes[0].textContent.trim() : item.textContent.trim();
            input.value = item.getAttribute('data-value') || '';
            valueEl.textContent = text;
            pick.classList.remove('is-open');
            input.dispatchEvent(new Event('change', { bubbles: true }));
          });
        });
      });
      document.addEventListener('click', function () {
        document.querySelectorAll('.jf-pick.is-open').forEach(function (pick) {
          pick.classList.remove('is-open');
        });
      });
      var contactForm = document.getElementById('foreign-staffing-contact');
      var mailBtn = document.getElementById('jf-form-mail');
      var lineBtn = document.getElementById('jf-form-line');
      var submitHint = document.getElementById('jf-form-submit-hint');
      function setSubmitEnabled(on) {
        [mailBtn, lineBtn].forEach(function (btn) {
          if (!btn) return;
          btn.disabled = !on;
          btn.setAttribute('aria-disabled', on ? 'false' : 'true');
          btn.classList.toggle('is-disabled', !on);
        });
        if (submitHint) submitHint.hidden = !!on;
      }
      function updateSubmitState() {
        if (!contactForm) return;
        var names = ['contract[company]', 'contract[name]', 'contract[tel]', 'contract[email]', 'contract[address]', 'wish_people', 'wish_days', 'wish_hours', 'wish_term'];
        var ready = names.every(function (name) {
          var el = contactForm.elements[name];
          return el && String(el.value || '').trim();
        });
        setSubmitEnabled(ready);
      }
      if (contactForm) {
        contactForm.addEventListener('input', updateSubmitState);
        contactForm.addEventListener('change', updateSubmitState);
        contactForm.addEventListener('submit', function () {
          var extras = [];
          contactForm.querySelectorAll('[data-staff-field]').forEach(function (el) {
            var label = el.getAttribute('data-staff-field');
            var text = el.value;
            if (el.tagName === 'SELECT' && el.selectedIndex >= 0) {
              text = el.options[el.selectedIndex].text;
            } else if (el.type === 'hidden') {
              var shown = el.parentNode.querySelector('.jf-pick__value');
              text = shown ? shown.textContent.trim() : el.value;
            }
            if (el.value) extras.push(label + ': ' + text);
          });
          var formPref = document.getElementById('jf-form-pref');
          var formAmount = document.getElementById('jf-form-price-amount');
          var quoteEl = document.getElementById('jf-form-quote');
          if (formPref && formPref.value) extras.push('都道府県: ' + formPref.options[formPref.selectedIndex].textContent);
          if (quoteEl && !quoteEl.hidden && formAmount && formAmount.textContent && formAmount.textContent !== '—') {
            extras.push('料金目安: ' + formAmount.textContent + '円〜／時間');
          }
          var msg = contactForm.querySelector('[name="contract[message]"]');
          if (msg && extras.length) {
            msg.value = extras.join('\n') + (msg.value ? '\n' + msg.value : '');
          }
        });
      }
      updateSubmitState();
    })();

    (function () {
      var PREF_WAGES = [
        { name: '北海道', wage: 1075 },
        { name: '青森県', wage: 1029 },
        { name: '岩手県', wage: 1031 },
        { name: '宮城県', wage: 1038 },
        { name: '秋田県', wage: 1031 },
        { name: '山形県', wage: 1032 },
        { name: '福島県', wage: 1033 },
        { name: '茨城県', wage: 1074 },
        { name: '栃木県', wage: 1068 },
        { name: '群馬県', wage: 1063 },
        { name: '埼玉県', wage: 1141 },
        { name: '千葉県', wage: 1140 },
        { name: '東京都', wage: 1226 },
        { name: '神奈川県', wage: 1225 },
        { name: '新潟県', wage: 1050 },
        { name: '富山県', wage: 1062 },
        { name: '石川県', wage: 1054 },
        { name: '福井県', wage: 1053 },
        { name: '山梨県', wage: 1052 },
        { name: '長野県', wage: 1061 },
        { name: '岐阜県', wage: 1065 },
        { name: '静岡県', wage: 1097 },
        { name: '愛知県', wage: 1140 },
        { name: '三重県', wage: 1087 },
        { name: '滋賀県', wage: 1080 },
        { name: '京都府', wage: 1122 },
        { name: '大阪府', wage: 1177 },
        { name: '兵庫県', wage: 1116 },
        { name: '奈良県', wage: 1051 },
        { name: '和歌山県', wage: 1045 },
        { name: '鳥取県', wage: 1030 },
        { name: '島根県', wage: 1033 },
        { name: '岡山県', wage: 1047 },
        { name: '広島県', wage: 1085 },
        { name: '山口県', wage: 1043 },
        { name: '徳島県', wage: 1046 },
        { name: '香川県', wage: 1036 },
        { name: '愛媛県', wage: 1033 },
        { name: '高知県', wage: 1023 },
        { name: '福岡県', wage: 1057 },
        { name: '佐賀県', wage: 1030 },
        { name: '長崎県', wage: 1031 },
        { name: '熊本県', wage: 1034 },
        { name: '大分県', wage: 1035 },
        { name: '宮崎県', wage: 1023 },
        { name: '鹿児島県', wage: 1026 },
        { name: '沖縄県', wage: 1023 }
      ];
      var COMMON_ADD = 200;
      var PLAN_EXTRAS = { light: 1400, standard: 1000, fulltime: 800 };
      var COUNT_KEY = 'jf_pref_switch_count';
      var PRICE_MARKUP = 100;

      var select = document.getElementById('jf-pref-select');
      var baseList = document.getElementById('jf-price-base-list');
      var baseAmount = document.getElementById('jf-price-base-amount');
      var baseNote = document.getElementById('jf-price-base-note');
      var cards = document.querySelectorAll('#jf-price-grid [data-plan]');
      if (!select || !baseAmount || !cards.length) return;

      function roundUpWage(wage) {
        return Math.ceil(wage / 200) * 200;
      }
      function formatYen(n) {
        return String(n).replace(/\B(?=(\d{3})+(?!\d))/g, ',');
      }
      function calcHourly(wage, plan) {
        return roundUpWage(wage) + COMMON_ADD + PLAN_EXTRAS[plan];
      }
      function minWage() {
        var min = PREF_WAGES[0].wage;
        for (var i = 1; i < PREF_WAGES.length; i++) {
          if (PREF_WAGES[i].wage < min) min = PREF_WAGES[i].wage;
        }
        return min;
      }
      function trackPrefSwitch(prefName) {
        var count = parseInt(localStorage.getItem(COUNT_KEY) || '0', 10) || 0;
        count += 1;
        localStorage.setItem(COUNT_KEY, String(count));
        if (typeof gtag === 'function') {
          gtag('event', 'prefecture_price_switch', {
            event_category: 'foreign_staffing',
            event_label: prefName || '全国（最安値）',
            value: count
          });
        }
      }
      function render(wage, label) {
        var cheapest = calcHourly(wage, 'fulltime');
        if (baseList) baseList.textContent = formatYen(cheapest + PRICE_MARKUP);
        baseAmount.textContent = formatYen(cheapest);
        baseNote.textContent = '（' + label + '）';
        cards.forEach(function (card) {
          var plan = card.getAttribute('data-plan');
          var price = calcHourly(wage, plan);
          var listPrice = price + PRICE_MARKUP;
          var listEl = card.querySelector('[data-price-list]');
          var amountEl = card.querySelector('[data-price-amount]');
          if (listEl) listEl.textContent = formatYen(listPrice);
          if (amountEl) amountEl.textContent = formatYen(price);
        });
      }

      PREF_WAGES.forEach(function (pref) {
        var opt = document.createElement('option');
        opt.value = String(pref.wage);
        opt.textContent = pref.name;
        opt.setAttribute('data-name', pref.name);
        select.appendChild(opt);
      });

      render(minWage(), '全国');

      select.addEventListener('change', function () {
        var selected = select.options[select.selectedIndex];
        var wage = select.value ? parseInt(select.value, 10) : minWage();
        var label = select.value ? selected.textContent : '全国';
        render(wage, label);
        trackPrefSwitch(select.value ? selected.textContent : '');
      });

      var daysEl = document.getElementById('jf-wish-days');
      var hoursEl = document.getElementById('jf-wish-hours');
      var quoteEl = document.getElementById('jf-form-quote');
      var quoteNote = document.getElementById('jf-form-quote-note');
      var formPref = document.getElementById('jf-form-pref');
      var formList = document.getElementById('jf-form-price-list');
      var formAmount = document.getElementById('jf-form-price-amount');
      var formPrefNote = document.getElementById('jf-form-price-note');
      if (formPref) {
        PREF_WAGES.forEach(function (pref) {
          var opt = document.createElement('option');
          opt.value = String(pref.wage);
          opt.textContent = pref.name;
          formPref.appendChild(opt);
        });
      }
      function planFromWish(days, hours) {
        if (days >= 5 && hours >= 8) return 'fulltime';
        if (days >= 3 && hours >= 5) return 'standard';
        if (days >= 2 && hours >= 4) return 'light';
        return null;
      }
      function updateFormQuote() {
        if (!quoteEl || !formAmount) return;
        var days = parseInt(daysEl && daysEl.value, 10);
        var hours = parseInt(hoursEl && hoursEl.value, 10);
        var wage = formPref && formPref.value ? parseInt(formPref.value, 10) : minWage();
        var label = formPref && formPref.value ? formPref.options[formPref.selectedIndex].textContent : '全国';
        var plan = planFromWish(days, hours) || 'light';
        var price = calcHourly(wage, plan);
        quoteEl.hidden = false;
        if (quoteNote) quoteNote.hidden = true;
        if (formList) formList.textContent = formatYen(price + PRICE_MARKUP);
        formAmount.textContent = formatYen(price);
        if (formPrefNote) formPrefNote.textContent = '（' + label + '）';
      }
      if (daysEl) daysEl.addEventListener('change', updateFormQuote);
      if (hoursEl) hoursEl.addEventListener('change', updateFormQuote);
      if (formPref) formPref.addEventListener('change', updateFormQuote);
      updateFormQuote();
    })();
