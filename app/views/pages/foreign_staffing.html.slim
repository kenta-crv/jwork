        { name: '茨城県', wage: 1074 },
        { name: '栃木県', wage: 1068 },
        { name: '群馬県', wage: 1063 },
        { name: '埼玉県', wage: 1141 },
        { name: '千葉県', wage: 1140 },
        { name: '東京都', wage: 1226 },
        { name: '神奈川県', wage: 1225 },
        { name: '新潟県', wage: 1050 },
        { name: '富山県', wage: 1062 },
