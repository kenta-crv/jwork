  header.jf-header
    .jf-container.jf-header__inner
      = link_to '/', class: 'jf-brand', aria: { label: 'J Work トップへ' } do
        = image_tag 'rogo.webp', alt: 'J Work', class: 'jf-brand__logo', width: '150', height: '54'

      nav.jf-nav aria-label="メインナビゲーション"
        = link_to 'お悩み', '#service', class: 'jf-nav__link'
        = link_to '選ばれる理由', '#features', class: 'jf-nav__link'
        = link_to '料金の目安', '#price', class: 'jf-nav__link'
        = link_to 'ご利用の流れ', '#flow', class: 'jf-nav__link'
        = link_to 'よくあるご質問', '#faq', class: 'jf-nav__link'

      button.jf-contact-button.jf-contact-button--header type="button" data-open-contact="true"
        span.jf-contact-button__icon aria-hidden="true"
          svg.jf-ico
            use href="#jf-i-mail"
        span.jf-contact-button__copy
          strong 求人を登録する
          small 審査のうえ公開

  main
    section#top.jf-hero
      .jf-hero__image aria-hidden="true" style="--jf-hero-image: url(#{asset_path('hero-foreign-workers.jpg')})"
      .jf-container.jf-hero__inner
        .jf-hero__content
          p.jf-hero__eyebrow J Work外国人｜掲載料無料の継続採用
          h1.jf-hero__title
            | 外国人材の求人なら
            br
            | J Work外国人に
            em お任せ！
          p.jf-hero__lead 登録者約4,000名のJ Work外国人へ、掲載料無料で継続採用の求人を届けます。

          ul.jf-hero__points
            li.jf-round-point
              span.jf-line-icon aria-hidden="true"
                svg.jf-ico
                  use href="#jf-i-calc"
              strong 掲載料
              b 無料
            li.jf-round-point
              span.jf-line-icon aria-hidden="true"
                svg.jf-ico
                  use href="#jf-i-building"
              strong 登録者4,000名
              b に直接リーチ
            li.jf-round-point
              span.jf-line-icon aria-hidden="true"
                svg.jf-ico
                  use href="#jf-i-heart-person"
              strong 応募・採用時
              b だけ課金

    section#service.jf-concerns.jf-section
      .jf-container
        h2.jf-section-title
          | こんな
          em お悩み
          | はありませんか？

        .jf-concerns__grid
          article.jf-concern-card
            span.jf-concern-card__icon aria-hidden="true"
              svg.jf-ico
                use href="#jf-i-worry"
            p
              | 求人を出しても
              br
              | 外国人材の応募が来ない
          article.jf-concern-card
            span.jf-concern-card__icon aria-hidden="true"
              svg.jf-ico
                use href="#jf-i-calc"
            p
              | 掲載料が高く、
              br
              | 採用費だけがかさむ
          article.jf-concern-card
            span.jf-concern-card__icon aria-hidden="true"
              svg.jf-ico
                use href="#jf-i-building"
            p
              | 外国人への届け方が
              br
              | わからず手が止まる
          article.jf-concern-card
            span.jf-concern-card__icon aria-hidden="true"
              svg.jf-ico
                use href="#jf-i-crossed"
            p
              | 応募が来ても条件が合わず
              br
              | 定着まで進まない

        span.jf-concerns__arrow aria-hidden="true"

        .jf-concerns__answer
          .jf-concerns__content
            .jf-concerns__headline
              span.jf-concerns__lead そのお悩み、
              span.jf-concerns__badge 掲載料無料の求人
            .jf-concerns__brand-row
              span.jf-concerns__mark aria-hidden="true"
                svg.jf-ico
                  use href="#jf-i-people"
              strong.jf-concerns__brand J Work外国人
              span.jf-concerns__suffix がすべて
              em.jf-concerns__solve 解決
              span.jf-concerns__suffix します。
          .jf-concerns__visual
            .jf-concerns__visual-frame
              = image_tag 'feature-team.jpg', alt: '', class: 'jf-concerns__visual-img'
            span.jf-concerns__deco.jf-concerns__deco--sparkle aria-hidden="true"
              svg viewBox="0 0 24 24" fill="currentColor"
                path d="M12 0l3 9 9 3-9 3-3 9-3-9-9-3 9-3z"
            span.jf-concerns__deco.jf-concerns__deco--chat aria-hidden="true"
              svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"
            span.jf-concerns__deco.jf-concerns__deco--chart aria-hidden="true"
              svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"
                line x1="18" y1="20" x2="18" y2="10"
                line x1="12" y1="20" x2="12" y2="4"
                line x1="6" y1="20" x2="6" y2="14"

    section#features.jf-features.jf-section
      .jf-container
        p.jf-section-kicker 外国人材に、直接届く。
        h2.jf-heading
          | J Work外国人が
          br
          em 選ばれる
          | 理由
        p.jf-heading-lead 掲載料無料で、J Work外国人へ継続採用の求人を出せます。

        .jf-features__grid
          article.jf-feature-card
            .jf-feature-card__body
              .jf-feature-card__meta
                span.jf-feature-card__icon aria-hidden="true"
                  svg.jf-ico
                    use href="#jf-i-sparkle"
                span.jf-feature-card__number 01
              h3 掲載料は無料
              p 求人の掲載自体に費用はかかりません。初期費用ゼロで、継続採用の求人をJ Work外国人へ出せます。
            = image_tag 'feature-retention.jpg', class: 'jf-feature-card__image', alt: '求人を確認する担当者', loading: 'lazy'
          article.jf-feature-card
            .jf-feature-card__body
              .jf-feature-card__meta
                span.jf-feature-card__icon aria-hidden="true"
                  svg.jf-ico
                    use href="#jf-i-team"
                span.jf-feature-card__number 02
              h3 J Work外国人へリーチ
              p 登録者約4,000名・新規登録毎月約500名。J Work外国人の登録者へ、求人を直接届けられます。
            = image_tag 'feature-matching.jpg', class: 'jf-feature-card__image', alt: '外国人材と企業のマッチング', loading: 'lazy'
          article.jf-feature-card
            .jf-feature-card__body
              .jf-feature-card__meta
                span.jf-feature-card__icon aria-hidden="true"
                  svg.jf-ico
                    use href="#jf-i-shield"
                span.jf-feature-card__number 03
              h3 応募課金か成果報酬
              p 収益化は応募課金、または採用が決まったときの成果報酬から選べます。掲載中に動かなければ掲載料は発生しません。
            = image_tag 'feature-training.jpg', class: 'jf-feature-card__image', alt: '現場で働くスタッフ', loading: 'lazy'

        p.jf-features__note
          | 求人を登録いただいたあと、自社審査のうえ公開します。応募者への面接・採用判断はお客様にてお願いしています。1日限り・単発のみの求人は対象外です。

    section#price.jf-price.jf-section
      .jf-container
        p.jf-section-kicker わかりやすく、安心の料金プラン
        h2.jf-heading
          em 料金
          | のご案内
        p.jf-heading-lead 掲載は無料です。単発のみの求人は対象外です。

        h3.jf-subheading 掲載プラン
        .jf-price__jobs
          article.jf-price-row.jf-price-row--featured
            span.jf-price-card__badge 掲載料無料
            header.jf-price-row__header
              h4 求人掲載プラン
              p J Work外国人へ、継続採用の求人を掲載したい企業様向け
            .jf-price-row__price
              span.jf-price-card__frequency 掲載そのものは
              p.jf-price-card__amount
                strong 無料
              small 初期費用 0円
            ul.jf-price-card__specs.jf-price-row__specs
              li
                span.jf-spec-ico aria-hidden="true"
                  svg.jf-ico
                    use href="#jf-i-clock"
                b 掲載料
                span 0円
              li
                span.jf-spec-ico aria-hidden="true"
                  svg.jf-ico
                    use href="#jf-i-people"
                b 初期費用
                span 0円
              li
                span.jf-spec-ico aria-hidden="true"
                  svg.jf-ico
                    use href="#jf-i-building"
                b おすすめ
                span 継続採用を始めたい企業
            button.jf-outline-button.jf-outline-button--filled type="button" data-open-contact="true" 求人を登録する

        h3.jf-subheading 課金プラン
        .jf-price__jobs
          article.jf-price-row.jf-price-row--featured
            span.jf-price-card__badge 人気No.1
            header.jf-price-row__header
              h4 求人応募課金プラン
              p 応募課金で、継続採用の費用を抑えたい企業様向け
            .jf-price-row__price
              span.jf-price-card__frequency 応募があったときだけ
              p.jf-price-card__amount
                strong 5,980
                span 円〜／応募
              small （税込 6,578円〜）
            ul.jf-price-card__specs.jf-price-row__specs
              li
                span.jf-spec-ico aria-hidden="true"
                  svg.jf-ico
                    use href="#jf-i-clock"
                b 課金
                span 1応募あたり
              li
                span.jf-spec-ico aria-hidden="true"
                  svg.jf-ico
                    use href="#jf-i-people"
                b 初期費用
                span 0円
              li
                span.jf-spec-ico aria-hidden="true"
                  svg.jf-ico
                    use href="#jf-i-building"
                b おすすめ
                span 応募課金で継続採用したい企業
            button.jf-outline-button.jf-outline-button--filled type="button" data-open-contact="true" 求人を登録する

          article.jf-price-row
            header.jf-price-row__header
              h4 求人成果報酬プラン
              p 成果報酬で、継続採用したい企業様
            .jf-price-row__price
              span.jf-price-card__frequency 採用が決まったとき
              p.jf-price-card__amount
                strong 198,000
                span 円〜／1名
              small （税込 217,800円〜）
            ul.jf-price-card__specs.jf-price-row__specs
              li
                span.jf-spec-ico aria-hidden="true"
                  svg.jf-ico
                    use href="#jf-i-clock"
                b 課金
                span 採用1名あたり
              li
                span.jf-spec-ico aria-hidden="true"
                  svg.jf-ico
                    use href="#jf-i-people"
                b 初期費用
                span 0円
              li
                span.jf-spec-ico aria-hidden="true"
                  svg.jf-ico
                    use href="#jf-i-building"
                b おすすめ
                span 成果報酬で継続採用したい企業
            button.jf-outline-button type="button" data-open-contact="true" 求人を登録する

        p.jf-price__note
          | ※掲載料は無料です。収益化は応募課金、または成果報酬です。
          br
          | ※1日限り・単発のみの求人は対象外です。継続的な勤務・採用の求人が対象です。
          br
          | ※お支払いは審査通過後にご案内します。クレジットカードが基本で、請求書払いも審査のうえ対応します。
          br
          | ※上記はあくまで一例です。条件の詳細は求人登録時にご記入ください。

    section#compare.jf-compare-section.jf-section
      .jf-container
        p.jf-section-kicker 従来の採用手段と比較
        h2.jf-heading
          | 採用手段との
          em 比較
        p.jf-heading-lead 掲載無料のあと、応募課金または成果報酬で継続採用できます。

        .jf-compare
          table.jf-compare__table
            thead
              tr
                th 比較
                th
                  span.jf-compare__col-name マイナビ転職
                  small 大手求人媒体
                th
                  span.jf-compare__col-name WORK JAPAN
                  small GaijinPot など
                th
                  span.jf-compare__col-name 人材紹介会社
                  small 成功報酬型
                th.jf-compare__ours-head
                  span.jf-compare__name J Work外国人
                  span.jf-compare__badge 掲載無料
            tbody
              tr
                th scope="row"
                  span.jf-compare__num 01
                  span.jf-compare__label 掲載料
                td.jf-compare__vs
                  span.jf-compare__price 20〜120万円／4週間
                  small 税別・企画により変動
                td.jf-compare__vs
                  span.jf-compare__price 4.5万円〜／4週間
                  small GaijinPotは月15万円〜
                td.jf-compare__vs
                  span.jf-compare__price 掲載無料
                  small 採用が決まるまで0円
                td.jf-compare__ours
                  strong.jf-compare__rate 無料
              tr
                th scope="row"
                  span.jf-compare__num 02
                  span.jf-compare__label 初期費用
                td.jf-compare__vs
                  span.jf-compare__price 掲載料が初期費用
                  small 応募がなくても発生
                td.jf-compare__vs
                  span.jf-compare__price 0円
                  small WORK JAPAN公式の案内
