- message = "I would like to apply for an interview for #{@recruit.title}."
- encoded_message = ERB::Util.url_encode(message)
- line_url = "https://line.me/R/oaMessage/@522jmsbm/?#{encoded_message}"

/ --- カスタム通知ツールチップ (Notice Tooltip) ---
#custom-notice role="alert" style="display:none; position:absolute; z-index:2147483647; min-width:220px; max-width:280px; background-color:#842029; color:#fff; border-radius:0.5rem; padding:0.6rem 0.9rem; box-shadow:0 0.4rem 0.8rem rgba(0,0,0,0.3); font-weight:bold; font-size:0.85rem; text-align:center; line-height:1.4;"
  | Before applying via LINE, please be sure to check the job details and recruitment area.
  span#custom-notice-arrow style="position:absolute; bottom:-7px; left:50%; transform:translateX(-50%); width:0; height:0; border-left:7px solid transparent; border-right:7px solid transparent; border-top:7px solid #842029;"

.job-detail-card
  / ===== ヘッダーセクション =====
  .job-header
    .job-header-badges
      span.badge-pill-primary Job Details
      - if @recruit.point.present?
        span.badge-pill-warning = "★ #{@recruit.point}"

    h2.job-title = @recruit.title

    .job-description
      = simple_format(@recruit.description)

  / ===== 単価（ハイライト） =====
  .job-price-section
    .job-price-label Base Pay / Unit Price
    .job-price-value = @recruit.unit_price

  / ===== 詳細情報リスト =====
  .job-info-list
    .job-info-item
      .job-info-label 🎁 Rewards & Incentives
      .job-info-value.highlight-red = simple_format(@recruit.reward)

    .job-info-item
      .job-info-label 🕐 Working Hours
      .job-info-value = simple_format(@recruit.working_hours)

    .job-info-item
      .job-info-label 📅 Working Days
      .job-info-value = simple_format(@recruit.working_days)

    .job-info-item
      .job-info-label 📍 Job Location
      .job-info-value = simple_format(@recruit.area)

    .job-info-item
      .job-info-label 💴 Payment Terms
      .job-info-value.highlight-red = simple_format(@recruit.payment)

    .job-info-item
      .job-info-label 🇯🇵 Japanese Proficiency
      .job-info-value = simple_format(@recruit.japanese_skill)

    .job-info-item
      .job-info-label ✅ Requirements
      .job-info-value = simple_format(@recruit.require)

    .job-info-item
      .job-info-label 📄 Employment Type
      .job-info-value = simple_format(@recruit.contract_type)

    .job-info-item
      .job-info-label 🚗 Vehicle Details
      .job-info-value.highlight-red.fw-bold = simple_format(@recruit.car_details)

    .job-info-item
      .job-info-label 💡 Why We Recommend
      .job-info-value = simple_format(@recruit.recommend)

    .job-info-item
      .job-info-label 🏷️ Category
      .job-info-value
        span.badge-category = @recruit.genre

    .job-info-item
      .job-info-label 📋 Eligible Visas
      .job-info-value = simple_format(Array(@recruit.visa).join("\n"))

    .job-info-item
      .job-info-label 📝 Additional Notes
      .job-info-value = simple_format(@recruit.remarks)

  / ===== チェックボックス =====
  .job-confirm-area
    label.job-confirm-label
      input type="checkbox" id="check-bottom-#{@recruit.id}" class="recruit-confirm-check" data-group="recruit-check"
      span.job-confirm-text I checked the job postings and recruitment areas.

  / ===== LINEボタン =====
  .job-apply-area
    = link_to line_url, class: "btn-line-apply action-link", data: { recruit_id: @recruit.id }, target: "_blank", rel: "noopener" do
      span.btn-line-icon
        / LINE icon SVG
        svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="20" height="20"
          path d="M19.365 9.863c.349 0 .63.285.63.631 0 .345-.281.63-.63.63H17.61v1.125h1.755c.349 0 .63.283.63.63 0 .344-.281.629-.63.629h-2.386c-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.63-.63h2.386c.349 0 .63.285.63.63 0 .349-.281.63-.63.63H17.61v1.125h1.755zm-3.855 3.016c0 .27-.174.51-.432.596-.064.021-.133.031-.199.031-.211 0-.391-.09-.51-.25l-2.443-3.317v2.94c0 .344-.279.629-.631.629-.346 0-.626-.285-.626-.629V8.108c0-.27.173-.51.43-.595.06-.023.136-.033.194-.033.195 0 .375.104.495.254l2.462 3.33V8.108c0-.345.282-.63.63-.63.345 0 .63.285.63.63v4.771zm-5.741 0c0 .344-.282.629-.631.629-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.627-.63.349 0 .631.285.631.63v4.771zm-2.466.629H4.917c-.345 0-.63-.285-.63-.629V8.108c0-.345.285-.63.63-.63.348 0 .63.285.63.63v4.141h1.756c.348 0 .629.283.629.63 0 .344-.281.629-.629.629M24 10.314C24 4.943 18.615.572 12 .572S0 4.943 0 10.314c0 4.811 4.27 8.842 10.035 9.608.391.082.923.258 1.058.59.12.301.079.766.038 1.08l-.164 1.02c-.045.301-.24 1.186 1.049.645 1.291-.539 6.916-4.078 9.436-6.975C23.176 14.393 24 12.458 24 10.314"
      span Apply via LINE

  / ===== フッター =====
  .job-footer
    = link_to "← Back to List", recruits_path, class: "btn-back"

    - if admin_signed_in?
      .job-admin-actions
        = link_to "Edit", edit_recruit_path(@recruit), class: "btn-admin-edit"
        = link_to "Delete", recruit_path(@recruit),
          method: :delete,
          data: { confirm: "Are you sure you want to delete this job post?" },
          class: "btn-admin-delete"

/ LINE応募確認・チェック連動スクリプト
javascript:
  (() => {
    const initRecruitShow = () => {
      const actionLinks = document.querySelectorAll('.action-link');
      const checkboxes = document.querySelectorAll('[data-group="recruit-check"]');
      const noticeBanner = document.getElementById('custom-notice');
      const noticeArrow = document.getElementById('custom-notice-arrow');
      
      // この画面に必要な主要要素がない場合は処理をスキップ（他画面でのエラー巻き込み防止）
      if (actionLinks.length === 0 && checkboxes.length === 0) return;
      
      let hideTimer;

      function showNoticeNear(targetEl) {
        if (!noticeBanner || !targetEl) return;
        clearTimeout(hideTimer);
        noticeBanner.style.display = 'block';
        noticeBanner.style.opacity = '1';

        const rect = targetEl.getBoundingClientRect();
        const scrollX = window.scrollX || window.pageXOffset;
        const scrollY = window.scrollY || window.pageYOffset;
        const noticeRect = noticeBanner.getBoundingClientRect();

        let top = rect.top + scrollY - noticeRect.height - 14;
        let left = rect.left + scrollX + (rect.width / 2) - (noticeRect.width / 2);

        let arrowOnBottom = true;
        if (rect.top < noticeRect.height + 20) {
          top = rect.bottom + scrollY + 14;
          arrowOnBottom = false;
        }

        const minLeft = scrollX + 8;
        const maxLeft = scrollX + document.documentElement.clientWidth - noticeRect.width - 8;
        if (left < minLeft) left = minLeft;
        if (left > maxLeft) left = maxLeft;

        noticeBanner.style.top = top + 'px';
        noticeBanner.style.left = left + 'px';

        if (noticeArrow) {
          const arrowLeft = (rect.left + scrollX + rect.width / 2) - left;
          noticeArrow.style.left = arrowLeft + 'px';
          if (arrowOnBottom) {
            noticeArrow.style.bottom = '-7px';
            noticeArrow.style.top = 'auto';
            noticeArrow.style.borderTop = '7px solid #842029';
            noticeArrow.style.borderBottom = 'none';
          } else {
            noticeArrow.style.top = '-7px';
            noticeArrow.style.bottom = 'auto';
            noticeArrow.style.borderBottom = '7px solid #842029';
            noticeArrow.style.borderTop = 'none';
          }
        }

        hideTimer = setTimeout(() => {
          noticeBanner.style.display = 'none';
        }, 3500);
      }

      function shakeCheckbox() {
        if (checkboxes.length === 0) return;
        const box = checkboxes[0].closest('.job-confirm-area') || checkboxes[0];
        if (!box) return;
        box.style.transition = 'box-shadow 0.2s ease';
        box.style.boxShadow = '0 0 0 3px rgba(220,53,69,0.6)';
        box.style.borderRadius = '0.4rem';
        setTimeout(() => {
          box.style.boxShadow = 'none';
        }, 1200);
      }

      checkboxes.forEach(checkbox => {
        checkbox.addEventListener('change', (e) => {
          checkboxes.forEach(cb => { cb.checked = e.target.checked; });
        });
      });

      actionLinks.forEach(link => {
        link.addEventListener('click', (e) => {
          const isChecked = checkboxes.length > 0 && Array.from(checkboxes).some(cb => cb.checked);
          if (!isChecked) {
            e.preventDefault();
            showNoticeNear(link);
            shakeCheckbox();
          }
        });
      });

      // スクロール時にツールチップを消す安全処理
      const handleScroll = () => {
        if (noticeBanner && noticeBanner.style.display === 'block') {
          noticeBanner.style.display = 'none';
          clearTimeout(hideTimer);
        }
      };
      window.removeEventListener('scroll', handleScroll);
      window.addEventListener('scroll', handleScroll, { passive: true });
    };

    // Turbo / Turbolinks / 通常ロードのすべてに対応
    document.addEventListener('DOMContentLoaded', initRecruitShow);
    document.addEventListener('turbo:load', initRecruitShow);
    document.addEventListener('turbolinks:load', initRecruitShow);
  })();