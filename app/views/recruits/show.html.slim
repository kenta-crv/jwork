.card.border-0.shadow-sm
  .card-body.p-0
    / Header: Title and Overview
    .p-4.bg-white
      span.badge.bg-primary.mb-2 Job Details
      - if @recruit.point.present?
              span.badge.bg-warning.text-dark = "★ #{@recruit.point}"
      - else
              span.text-muted Not Specified
      h2.h4.fw-bold.mb-3 
      = @recruit.title
      .text-muted.small.bg-light.p-3.rounded
        = simple_format(@recruit.description)


    / Main Info: Organized Table Format
    table.table.table-bordered.mb-0
      tbody
        tr
          th.bg-light.text-muted.fw-normal.align-middle width="30%" Base Pay / Unit Price
          td.align-middle.py-3
            .red 
              span.h5.fw-bold.text-dark = @recruit.unit_price

        tr
          th.bg-light.text-muted.fw-normal.align-middle Rewards & Incentives
          td.align-middle.py-3
            span.fw-bold.text-danger = simple_format(@recruit.reward)

        tr
          th.bg-light.text-muted.fw-normal.align-middle Working Hours
          td.align-middle = simple_format(@recruit.working_hours)

        tr
          th.bg-light.text-muted.fw-normal.align-middle Working Days
          td.align-middle = simple_format(@recruit.working_days)

        tr
          th.bg-light.text-muted.fw-normal.align-middle Job Location
          td.align-middle = simple_format(@recruit.area)

        tr
          th.bg-light.text-muted.fw-normal.align-middle Payment Terms
          td.align-middle.text-danger = simple_format(@recruit.payment)

        tr
          th.bg-light.text-muted.fw-normal.align-middle Japanese Proficiency
          td.align-middle = simple_format(@recruit.japanese_skill)

        tr
          th.bg-light.text-muted.fw-normal.align-middle Requirements
          td.align-middle = simple_format(@recruit.require)

        tr
          th.bg-light.text-muted.fw-normal.align-middle Employment Type
          td.align-middle = simple_format(@recruit.contract_type)

        tr
          th.bg-light.text-muted.fw-normal.align-middle Vehicle Details
          td.align-middle.text-danger.fw-bold = simple_format(@recruit.car_details)

        / ===== Additional Columns =====
        tr
          th.bg-light.text-muted.fw-normal.align-middle Why We Recommend
          td.align-middle = simple_format(@recruit.recommend)

        tr
          th.bg-light.text-muted.fw-normal.align-middle Category
          td.align-middle
            span.badge.bg-secondary = @recruit.genre

        tr
          th.bg-light.text-muted.fw-normal.align-middle Eligible Visas
          td.align-middle
            = simple_format(Array(@recruit.visa).join("\n"))

        / ===== Existing =====
        tr
          th.bg-light.text-muted.fw-normal.align-middle Additional Notes
          td.align-middle = simple_format(@recruit.remarks)

  / Action Area
  - if admin_signed_in?
   .card-footer.bg-light.p-3
    .d-grid.gap-2.d-md-flex.justify-content-md-end
      = link_to "Back", recruits_path, class: "btn btn-outline-secondary px-4"
      = link_to "Edit", edit_recruit_path(@recruit), class: "btn btn-warning px-4"
      = link_to "Delete", recruit_path(@recruit),
        method: :delete,
        data: { confirm: "Are you sure you want to delete this job post?" },
        class: "btn btn-danger px-4"