.jobs-card.jobs-card--stack
  = form_with model: @recruit, local: true, class: "jobs-form" do |f|
    .jobs-form__field
      = f.label :title, "案件名"
      = f.text_field :title, class: "jobs-form__input", placeholder: "例: Bicycle delivery in Edogawa"
    .jobs-form__field
      = f.label :description, "案件概要"
      = f.text_area :description, class: "jobs-form__input", rows: 4
    .jobs-form__field
      = f.label :recommend, "recommend"
      = f.text_area :recommend, class: "jobs-form__input", rows: 4
    .jobs-form__field
      = f.label :point, "ポイント"
      = f.select :point, (0..5).to_a, {}, { class: "jobs-form__input" }
    .jobs-form__field
      = f.label :genre, "genre"
      = f.select :genre, [["cleaning", "cleaning"], ["driver", "driver"]], { include_blank: "選択してください" }, { class: "jobs-form__input" }
    .jobs-form__field
      = f.label :unit_price, "日給例"
      = f.text_field :unit_price, class: "jobs-form__input"
    .jobs-form__field
      = f.label :reward, "報酬例（計算式など）"
      = f.text_area :reward, class: "jobs-form__input", rows: 3
    .jobs-form__field
      = f.label :working_hours, "勤務時間"
      = f.text_area :working_hours, class: "jobs-form__input"
    .jobs-form__field
      = f.label :working_days, "勤務日数"
      = f.text_area :working_days, class: "jobs-form__input"
    .jobs-form__field
      = f.label :area, "エリア"
      = f.text_area :area, class: "jobs-form__input"
    .jobs-form__field
      = f.label :payment, "支払い日"
      = f.text_area :payment, class: "jobs-form__input"
    .jobs-form__field
      = f.label :japanese_skill, "japanese_skill"
      = f.text_area :japanese_skill, class: "jobs-form__input"
    .jobs-form__field
      = f.label :require, "require"
      = f.text_area :require, class: "jobs-form__input"
    .jobs-form__field
      = f.label :contract_type, "contract_type"
      = f.text_area :contract_type, class: "jobs-form__input"
    .jobs-form__field
      = f.label :visa, "visa"
      = f.select :visa, ["日本国籍", "永住ビザ", "長期滞在ビザ", "定住ビザ", "難民ビザ", "家族滞在ビザ", "留学ビザ"], {}, class: "jobs-form__input", multiple: true
    .jobs-form__field
      = f.label :car_details, "car_details"
      = f.text_area :car_details, class: "jobs-form__input"
    .jobs-form__field
      = f.label :remarks, "備考・注意事項"
      = f.text_area :remarks, class: "jobs-form__input", rows: 4
    .jobs-form__actions
      = f.submit "この内容で保存する", class: "jobs-search__submit"
      - back_path = @recruit.persisted? ? recruit_path(@recruit) : recruits_path
      = link_to "キャンセルして戻る", back_path, class: "jobs-back", data: { turbolinks: false }
