h2 案件一覧
-if admin_signed_in?
 .mb-3
  = link_to "新規案件登録", new_recruit_path, class: "btn btn-success"

.row
  - @recruits.each do |recruit|
    .col-md-6.mb-4
      .job-card.p-3.border.rounded.h-100
        h3 = recruit.title
        p = truncate(recruit.description, length: 100)
        .mt-2
          strong 日給例: 
          span = recruit.unit_price
        .mt-3
          = link_to "詳細を見る", recruit_path(recruit), class: "btn btn-danger btn-sm me-2"
          = link_to "編集", edit_recruit_path(recruit), class: "btn btn-warning btn-sm"

          