h2 案件一覧
- if admin_signed_in?
  .mb-3
    = link_to "新規案件登録", new_recruit_path, class: "btn btn-success"

.row
  - @recruits.each do |recruit|
    .col-md-6.mb-4
      .job-card.p-3.border.rounded.h-100.position-relative.hover-card
        - if recruit.point.present?
          span.badge.bg-warning.text-dark = "★ #{recruit.point}"
        
        h3 = recruit.title
        p = truncate(recruit.description, length: 100)
        
        .mt-2
          strong Price: 
          span.price-text = recruit.unit_price
        / --- エリア表示（青） ---
        - if recruit.area.present?
          .area-btn-container
            - recruit.area.split('・').each do |a|
              span.area-btn-outline
                = a

        / --- おすすめ表示（緑） ---
        - if recruit.recommend.present?
          .recommend-container
            - recruit.recommend.split('・').each do |r|
              span.recommend-tag
                = r
        
        
        .mt-3.d-flex.align-items-center
          = link_to "", recruit_path(recruit), class: "stretched-link"
          
          - if admin_signed_in?
            = link_to "編集", edit_recruit_path(recruit), class: "btn btn-warning btn-sm position-relative", style: "z-index: 2;"