- set_meta_tags title: @client.company, noindex: true

.auth-screen.auth-screen--admin.auth-screen--wide
  .auth-screen__mesh
  .auth-screen__orb.auth-screen__orb--a
  .auth-screen__orb.auth-screen__orb--b
  .auth-screen__grain
  .auth-screen__layout
    aside.auth-screen__brand
      p.auth-screen__kicker Client CRM
      h1.auth-screen__title = @client.company
      p.auth-screen__ja 顧客詳細
    .user-desk.auth-screen__card.client-crm
      - if notice.present?
        p.auth-screen__flash.auth-screen__flash--notice = notice
      - if alert.present?
        p.auth-screen__flash.auth-screen__flash--alert = alert

      .client-crm__detail-head
        .client-crm__actions
          = link_to "一覧へ戻る", clients_path, class: "btn btn-default btn-xs"
          = button_to "マイページ案内を送る", send_portal_invite_client_path(@client), class: "btn btn-primary btn-xs", data: { confirm: "パスワード設定の案内を送信しますか？" }
          = link_to "案件を追加", new_client_job_path(@client), class: "btn btn-default btn-xs"
          = link_to "編集", edit_client_path(@client), class: "btn btn-default btn-xs"
          = link_to "削除", client_path(@client), method: :delete, data: { confirm: "本当に削除しますか？" }, class: "btn btn-danger btn-xs"

      h3.headline 基本情報
      table.company
        tbody
          tr
            th 会社名
            td = @client.company
          tr
            th 役職
            td = @client.position.presence || "—"
          tr
            th 担当者
            td = @client.person.presence || "—"
          tr
            th 電話番号
            td = @client.tel.presence || "—"
          tr
            th 携帯番号
            td = @client.mobile.presence || "—"
          tr
            th メールアドレス
            td = @client.email.presence || "—"
          tr
            th 所在地
            td = @client.address.presence || "—"
          tr
            th 企業URL
            td
              - if @client.url.present?
                = link_to @client.url, @client.url, target: "_blank", rel: "noopener"
              - else
                | —
          tr
            th 業種
            td = @client.industry.presence || "—"
          tr
            th 商談日時
            td = @client.meeting.presence || "—"
          tr
            th 備考
            td = simple_format(@client.remarks.presence || "—")

      h3.headline 求人の審査
      - if @client.recruits.any?
        table.company
          thead
            tr
              th 案件名
              th 状態
              th 操作
          tbody
            - @client.recruits.each do |recruit|
              tr
                td = recruit.title.presence || "無題"
                td
                  span class=("client-crm__badge client-crm__badge--#{recruit.published? ? 'live' : 'review'}") = recruit.listing_status
                td.client-crm__row-actions
                  = link_to "内容を確認", edit_recruit_path(recruit), class: "btn btn-default btn-xs"
                  - unless recruit.published?
                    = button_to "公開する", publish_recruit_path(recruit), class: "btn btn-primary btn-xs"
      - else
        p.client-crm__empty-row 求人はまだありません。

      h3.headline 案件台帳
      - if @client.jobs.any?
        table.company
          thead
            tr
              th 内容
              th 勤務時間
              th エリア
              th 仕入
              th 販売
              th 支払
              th 配送
              th レンタル
              th 備考
              th
          tbody
            - @client.jobs.each do |job|
              tr
                td = job.content
                td = job.working_time
                td = job.area
                td = job.purchase_price
                td = job.sales_price
                td = job.payment
                td = job.delivery
                td = job.rental
                td = job.remarks
                td.client-crm__row-actions
                  = link_to "編集", edit_client_job_path(@client, job), class: "btn btn-default btn-xs"
                  = link_to "削除", client_job_path(@client, job), method: :delete, data: { confirm: "本当に削除しますか？" }, class: "btn btn-danger btn-xs"
      - else
        p.client-crm__empty-row 案件はまだありません。

      h3.headline 商談ステータス
      = form_for [@client, @situation], html: { class: "client-crm__situation-form" } do |f|
        table.company
          thead
            tr
              th ステータス
              th 次回営業日
              th コメント
          tbody
            tr
              td = f.select :status, [["契約", "契約"], ["NG", "NG"]], { include_blank: "選択してください" }, class: "form-control"
              td = f.datetime_field :next, class: "form-control"
              td = f.text_area :body, class: "form-control", rows: 2
            tr
              td colspan="3"
                .client-crm__form-actions
                  = f.submit "登録する", class: "btn btn-primary"
        p.client-crm__hint 商談ステータスを入れる場合は商談日を入力してください。

      - situations = @client.situations.reject(&:new_record?)
      - if situations.any?
        table.company
          thead
            tr
              th ステータス
              th 次回営業日
              th コメント
              th
          tbody
            - situations.each do |situation|
              tr
                td = situation.status
                td = situation.next
                td = situation.body
                td.client-crm__row-actions
                  = link_to "編集", edit_client_situation_path(@client, situation), class: "btn btn-default btn-xs"
                  = link_to "削除", client_situation_path(@client, situation), method: :delete, data: { confirm: "本当に削除しますか？" }, class: "btn btn-danger btn-xs"
