- set_meta_tags noindex: true
.tops-wrapper
  h2.headline 基本情報
  = link_to "ジョブを新規作成", new_client_job_path(@client), class: "btn btn-primary"
  br/
  br/
  table.company
    colgroup
      col width="10%"
      col width="20%"
      col width="70%"
    tbody
      tr
        td.label-cell
          strong.label 必須
        td.arrow-box-cell
          | 会社名
        td.responsive-cell
          = @client.company
      tr
        td.label-cell
          strong.label 必須
        td.arrow-box-cell
          | 役職
        td.responsive-cell
          = @client.position
      tr
        td.label-cell
          strong.label 必須
        td.arrow-box-cell
          | 担当者
        td.responsive-cell
          = @client.person
      tr
        td.label-cell
          strong.label 必須
        td.arrow-box-cell
          | 電話番号
        td.responsive-cell
          = @client.tel
      tr
        td.label-cell
          strong.label 必須
        td.arrow-box-cell
          | 携帯番号
        td.responsive-cell
          = @client.mobile
      tr
        td.label-cell
          strong.label 必須
        td.arrow-box-cell
          | メールアドレス
        td.responsive-cell
          = @client.email
      tr
        td.label-cell
          strong.label 必須
        td.arrow-box-cell
          | 所在地
        td.responsive-cell
          = @client.address
      tr
        td.label-cell
          strong.label 必須
        td.arrow-box-cell
          | 企業URL
        td.responsive-cell
          = @client.url
      tr
        td.label-cell
          strong.label 必須
        td.arrow-box-cell
          | 商談日時
        td.responsive-cell
          = @client.meeting
      tr
        td.label-cell
          strong.label 必須
        td.arrow-box-cell
          | 商談日時
        td.responsive-cell
          = @client.remarks


br/
br/
table.company[width="100%"]
  - if @client.jobs.any?
    tbody
      tr
        th 内容
        th 勤務時間
        th エリア
        th 仕入れ価格
        th 販売価格
        th 配送
        th 支払い
        th 備考
      - @client.jobs.each do |job|
        tr
          td
            = job.content
          td
            = job.working_time
          td
            = job.area
          td
            = job.purchase_price
          td
            = job.sales_price
          td
            = job.delivery
          td
            = job.payment
          td
            = job.remarks
