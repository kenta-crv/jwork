h2 顧客一覧

/ フィルターボタン
.mb-3
  button.btn.btn-primary.filter-btn[data-target="all" style="margin-right: 5px;"] 全て表示
  button.btn.btn-primary.filter-btn[data-target="cargo" style="margin-right: 5px;"] 軽貨物業
  button.btn.btn-primary.filter-btn[data-target="security" style="margin-right: 5px;"] 警備業
  button.btn.btn-primary.filter-btn[data-target="cleaning" style="margin-right: 5px;"] 清掃業
  button.btn.btn-primary.filter-btn[data-target="other"] その他

br/

.table-scroll
  table.table.table-bordered.company
    tbody
      - mapping = { "軽貨物業" => "cargo", "警備業" => "security", "清掃業" => "cleaning", "その他" => "other" }

      - @clients.each do |client|
        - industry_code = mapping[client.industry] || ""

        / --- 親行：会社基本情報 ---
        tr.filter-item.table-secondary.font-weight-bold[data-industry="#{industry_code}"]
          td
            .d-flex.gap-1
              = link_to '編集', edit_client_path(client), class: "btn btn-sm btn-success"
              = link_to '削除', client_path(client), method: :delete, data: { confirm: '本当に削除しますか？' }, class: "btn btn-sm btn-danger"
          td[colspan="2"]
            span.badge.badge-info.mr-2 = client.industry
            = client.company
          td[colspan="2"] 担当: #{client.person}
          td[colspan="2"] TEL: #{client.tel} (#{client.mobile})
          td[colspan="3"] Email: #{client.email}

        / --- 子行：案件情報 ---
        - client.jobs.each do |job|
          tr.filter-item[data-industry="#{industry_code}"]
            td
            td.wrap-25
              i.fas.fa-level-up-alt.fa-rotate-90.text-muted.mr-2
              = job.content
            td = job.working_time
            td = job.area
            td = job.purchase_price
            td = job.sales_price
            td = job.delivery
            td = job.rental
            td = job.payment
            td.wrap-25 = job.remarks