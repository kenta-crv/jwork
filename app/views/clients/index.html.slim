table.company[width="100%"]
  thead
    tr
      th 会社名
      th 内容
      th 勤務時間
      th エリア
      th 仕入れ価格
      th 販売価格
      th 配送
      th 支払い
      th 備考
  tbody
    - @clients.each do |client|
      - if client.jobs.any?
        - client.jobs.each do |job|
          tr
            td= link_to client.company, client_path(client)
            td= job.content
            td= job.working_time
            td= job.area
            td= job.purchase_price
            td= job.sales_price
            td= job.delivery
            td= job.payment
            td= job.remarks
      - else
        tr
          td= link_to client.company, client_path(client)
          td[colspan=8] なし
