h2 顧客一覧

/ フィルターボタン（高さを抑え、操作性を向上）
.mb-3
  - ["all", "cargo", "security", "cleaning", "other"].each do |t|
    button.btn.btn-sm.filter-btn[data-target="#{t}" class="#{t=='all' ? 'btn-primary' : 'btn-outline-primary'}" style="margin-right:4px; font-weight:bold;"]
      = t == 'all' ? '全表示' : (t == 'cargo' ? '軽貨物' : t == 'security' ? '警備' : t == 'cleaning' ? '清掃' : 'その他')

.client-list style="max-width: 100%; overflow-x: hidden;"
  - mapping = { "軽貨物業" => "cargo", "警備業" => "security", "清掃業" => "cleaning", "その他" => "other" }

  - @clients.each do |client|
    - industry_code = mapping[client.industry] || ""
    
    / 顧客ブロック：外枠をシャープにし、余白を削ぎ落とし
    .filter-item[data-industry="#{industry_code}" style="margin-bottom: 15px; border: 2px solid #444; background: #fff;"]
      
      / --- 会社行：情報を一行に凝縮 ---
      .client-header style="display: flex; align-items: center; background: #444; color: #fff; padding: 4px 12px; font-size: 0.9rem;"
        span style="background: #ffc107; color: #000; padding: 0 6px; border-radius: 2px; font-size: 0.75rem; font-weight: bold; margin-right: 10px;" = client.industry
        strong style="font-size: 1.6rem;" = link_to client.company, client_path(client), style: "color: #fff;"
        span style="margin-left: auto; font-size: 1.4rem"
          |  #{client.person} / #{client.tel} / #{client.address} / #{client.email}
          = link_to ' 編集 ', edit_client_path(client), class: "btn btn-xs btn-success", style: "padding: 0 5px; margin-left: 10px; font-size:1.2rem;"
          = link_to ' 削除 ', client_path(client), method: :delete, data: { confirm: '削除？' }, class: "btn btn-xs btn-danger", style: "padding: 0 5px; margin-left: 5px; font-size: 1.2rem;"

      / --- 案件台帳：表形式を「案件単位」で作成 ---
      - if client.jobs.any?
        table style="width: 100%; border-collapse: collapse; table-layout: fixed; font-size: 0.85rem;"
          thead style="background: #f2f2f2; border-bottom: 1px solid #ccc;"
            tr
              th style="width: 25%; border-right: 1px solid #ccc; padding: 2px 5px;" 案件内容
              th style="width: 12%; border-right: 1px solid #ccc; padding: 2px 5px;" 勤務/エリア
              th style="width: 18%; border-right: 1px solid #ccc; padding: 2px 5px; background: #fff0f0;" 仕入/販売/支払
              th style="width: 15%; border-right: 1px solid #ccc; padding: 2px 5px;" 配送/レンタル
              th style="width: 30%; padding: 2px 5px;" 備考
          tbody
            - client.jobs.each do |job|
              tr style="border-bottom: 1px solid #eee;"
                td style="padding: 5px; border-right: 1px solid #ccc; vertical-align: top; line-height: 1.2;"
                  strong style="color: #007bff; font-size: 1.5rem;" = job.content
                td style="padding: 2px 5px; border-right: 1px solid #ccc; vertical-align: top;"
                  div = job.working_time
                  div style="color: #000; font-size: 1.2rem;" = job.area
                td style="font-size: 1.4rem; padding: 2px 5px; border-right: 1px solid #ccc; vertical-align: top; background: #fffcfc;"
                  div style="color: #d9534f; font-weight: bold;" 仕: #{job.purchase_price}
                  div style="color: #0275d8; font-weight: bold;" 販: #{job.sales_price}
                  div style="font-size: 0.75rem; border-top: 1px solid #ffe0e0;" 支: #{job.payment}
                td style="padding: 2px 5px; border-right: 1px solid #ccc; vertical-align: top; font-size: 1.2rem;"
                  div 配送: #{job.delivery}
                  div 貸: #{job.rental}
                td style="padding: 2px 5px; vertical-align: top; font-size: 0.8rem; color: #444; font-size: 1.2rem;"
                  = job.remarks
      - else
        .no-jobs style="padding: 5px 15px; color: #999; font-size: 0.8rem;" 案件登録なし

javascript:
  document.addEventListener("turbolinks:load", function() {
    const buttons = document.querySelectorAll('.filter-btn');
    const items = document.querySelectorAll('.filter-item');
    buttons.forEach(btn => {
      btn.addEventListener('click', function() {
        buttons.forEach(b => b.classList.replace('btn-primary', 'btn-outline-primary'));
        this.classList.replace('btn-outline-primary', 'btn-primary');
        const target = this.dataset.target;
        items.forEach(item => {
          item.style.display = (target === 'all' || item.dataset.industry === target) ? 'block' : 'none';
        });
      });
    });
  });