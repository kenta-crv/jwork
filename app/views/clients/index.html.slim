- set_meta_tags title: "顧客一覧", noindex: true
- mapping = { "軽貨物業" => "cargo", "警備業" => "security", "清掃業" => "cleaning", "その他" => "other" }
- filter_labels = [["all", "全表示"], ["cargo", "軽貨物"], ["security", "警備"], ["cleaning", "清掃"], ["other", "その他"]]

.auth-screen.auth-screen--admin.auth-screen--wide
  .auth-screen__mesh
  .auth-screen__orb.auth-screen__orb--a
  .auth-screen__orb.auth-screen__orb--b
  .auth-screen__grain
  .auth-screen__layout
    aside.auth-screen__brand
      p.auth-screen__kicker Client CRM
      h1.auth-screen__title Clients
      p.auth-screen__ja 顧客一覧
    .user-desk.auth-screen__card.client-crm.client-crm--compact
      - if notice.present?
        p.auth-screen__flash.auth-screen__flash--notice = notice
      - if alert.present?
        p.auth-screen__flash.auth-screen__flash--alert = alert

      .client-crm__toolbar
        p.client-crm__count
          | 件数
          strong = @clients.size
        .client-crm__filters
          - filter_labels.each_with_index do |(code, label), i|
            button.client-crm__filter type="button" data-target=code class=("is-active" if i.zero?) = label
        = link_to "新規登録", new_client_path, class: "btn btn-primary btn-xs"

      - if @clients.blank?
        p.client-crm__empty 顧客はまだありません。
      - else
        .client-crm__list
          - @clients.each do |client|
            - industry_code = mapping[client.industry].presence || "other"
            - pending = client.recruits.reject(&:published?)
            - published = client.recruits.select(&:published?)
            article.client-crm__card.filter-item data-industry=industry_code
              .client-crm__row
                .client-crm__main
                  .client-crm__badges
                    - if client.industry.present?
                      span.client-crm__badge = client.industry
                    - if pending.any?
                      span.client-crm__badge.client-crm__badge--review 審査中 #{pending.size}
                    - if published.any?
                      span.client-crm__badge.client-crm__badge--live 公開中 #{published.size}
                  h2.client-crm__company = link_to client.company.presence || "会社名未設定", client_path(client)
                  p.client-crm__line
                    = [client.person, client.tel, client.mobile, client.email, client.address].map { |v| v.presence || "—" }.join(" ／ ")
                  - if client.recruits.any?
                    p.client-crm__line.client-crm__line--sub
                      = client.recruits.map { |r| "#{r.title.presence || '無題'}（#{r.listing_status}）" }.join("、 ")
                  - elsif client.jobs.any?
                    p.client-crm__line.client-crm__line--sub
                      = client.jobs.first(2).map { |j| j.content.presence || "案件" }.join("、 ")
                      - if client.jobs.size > 2
                        |  ほか#{client.jobs.size - 2}件
                .client-crm__actions
                  = link_to "詳細", client_path(client), class: "btn btn-primary btn-xs"
                  = link_to "編集", edit_client_path(client), class: "btn btn-default btn-xs"
                  = link_to "削除", client_path(client), method: :delete, data: { confirm: "削除しますか？" }, class: "btn btn-danger btn-xs"

javascript:
  document.addEventListener("turbolinks:load", function() {
    var buttons = document.querySelectorAll(".client-crm__filter");
    var items = document.querySelectorAll(".filter-item");
    if (!buttons.length) return;
    buttons.forEach(function(btn) {
      btn.addEventListener("click", function() {
        buttons.forEach(function(b) { b.classList.remove("is-active"); });
        btn.classList.add("is-active");
        var target = btn.dataset.target;
        items.forEach(function(item) {
          item.style.display = (target === "all" || item.dataset.industry === target) ? "" : "none";
        });
      });
    });
  });
