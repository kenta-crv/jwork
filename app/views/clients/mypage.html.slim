- set_meta_tags title: "マイページ", noindex: true

.auth-screen.auth-screen--client.auth-screen--wide
  .auth-screen__mesh
  .auth-screen__orb.auth-screen__orb--a
  .auth-screen__orb.auth-screen__orb--b
  .auth-screen__grain
  .client-portal
    .client-portal__top
      = link_to "/", class: "client-portal__logo" do
        = image_tag "rogo.webp", alt: "J Work", class: "client-portal__logo-img"
      .client-portal__top-copy
        p.client-portal__kicker 取引先マイページ
        h1.client-portal__title = @client.company.presence || "マイページ"
      = link_to "ログアウト", destroy_client_session_path, method: :delete, class: "client-portal__logout"

    - if notice.present?
      p.client-portal__flash.client-portal__flash--notice = notice
    - if alert.present?
      p.client-portal__flash.client-portal__flash--alert = alert

    .client-portal__grid
      section.client-portal__panel
        .client-portal__panel-head
          div
            h2.client-portal__heading 登録中の求人
            p.client-portal__lead 審査状況の確認と、内容の修正ができます。
          = link_to "求人を新規作成", new_recruit_path, class: "client-portal__btn"
        - if @recruits.present?
          ul.client-portal__jobs
            - @recruits.each do |recruit|
              li.client-portal__job
                .client-portal__job-main
                  p.client-portal__job-title = recruit.title.presence || "無題"
                  span class=("client-portal__badge client-portal__badge--#{recruit.published? ? "live" : "review"}") = recruit.listing_status
                  - unless recruit.published?
                    p.client-portal__job-note 審査が終わるまで、公開一覧には出ません。
                .client-portal__job-actions
                  = link_to "内容を確認・編集", edit_recruit_path(recruit), class: "client-portal__text-link"
                  - if recruit.published?
                    = link_to "公開ページを見る", recruit_path(recruit), class: "client-portal__text-link"
        - else
          .client-portal__empty
            p.client-portal__empty-title まだ求人はありません
            p.client-portal__empty-text 「求人を新規作成」から登録できます。審査のあと、公開一覧に出ます。

      aside.client-portal__panel.client-portal__panel--side
        h2.client-portal__heading 基本情報
        dl.client-portal__dl
          div
            dt 会社名
            dd = @client.company.presence || "—"
          div
            dt 担当者
            dd = @client.person.presence || "—"
          div
            dt メールアドレス
            dd = @client.email.presence || "—"
          div
            dt 電話番号
            dd = @client.tel.presence || "—"
