h3 Interviewed ユーザー表示

/ 横スクロールを強制的に有効にするラッパー
div style="overflow-x: auto; -webkit-overflow-scrolling: touch;"
  / min-width を設定することで、画面が狭くなった時にテーブルが潰れずスクロールが発生します
  table.list style="width: 100%; min-width: 1250px; table-layout: fixed; border-collapse: collapse;"
    thead
      tr
        th style="width: 100px;" User_name
        th style="width: 110px;" Phone_number
        th style="width: 40px;" age
        th style="width: 120px;" Address
        th style="width: 100px;" VISA
        th style="width: 80px;" Level
        th style="width: 60px;" Years 
        th style="width: 80px;" Start 
        th style="width: 180px;" Remarks 
        th style="width: 130px;" SMS
        th style="width: 150px;"
          |Register_date
          br/
          |(Updated_at)
        / アイコン6つ分が余裕を持って収まる幅に変更
        th style="width: 160px;" Action
    tbody
      - @users.each do |user|
        tr
          td style="word-break: break-all;" = link_to user.name, user_path(user)
          td= user.tel
          td= user.age
          td style="word-break: break-all;" = user.address
          td style="word-break: break-all;" = user.work_range
          td style="word-break: break-all;" = user.speak_japanese
          td= user.past_year
          td style="word-break: break-all;" = user.period
          td style="word-break: break-all;" = user.remarks
          td
            - status_options = User.statuses.keys.map do |key|
              - display_name = key.humanize
              - if key == "sms" || key == "line"
                - display_name = key.upcase
              - [display_name, key]

            = select_tag :status, 
                         options_for_select(status_options, user.status),
                         class: 'form-control update-status',
                         data: { user_id: user.id },
                         style: 'width: 120px;'
          td style="font-size: 11px;"
            = user.created_at ? user.created_at.strftime("%Y/%m/%d %H:%M") : "―"
            br/
            |(
            = user.updated_at ? user.updated_at.strftime("%H:%M") : "―"
            |)
          / thead の th と幅を合わせて、改行を禁止（nowrap）
          td style="width: 160px; white-space: nowrap; vertical-align: middle;"
            span.copy-btn data-clipboard-text=user.interview_request_text style="cursor:pointer;"
              = image_tag("icon_information.png", width: 18)
            span.copy-btn data-clipboard-text=user.contract_request_text style="cursor:pointer; margin-left: 4px;"
              = image_tag("icon_copy.png", width: 18)
            = link_to user.account_name, target: "_blank", style: "margin-left: 4px;" do
              = image_tag("icon_line.png", width: 18)
            = link_to send_sms_user_path(user), method: :post, data: { confirm: "送信しますか？" }, style: "margin-left: 4px;" do
              = image_tag("icon_sms.png", width: 18)
            = link_to edit_user_path(user), style: "margin-left: 4px;" do
              = image_tag("icon_edit.png", width: 18)
            = link_to user_path(user), method: :delete, data: { confirm: '削除しますか？' }, style: "margin-left: 4px;" do
              = image_tag("icon_trash.png", width: 18)

= paginate @users