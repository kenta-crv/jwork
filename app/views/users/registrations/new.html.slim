- set_meta_tags noindex: true
.tops-wrapper
  h2.headline 日本語で情報を入力してください。[Please enter the information in Japanese.]

  = form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f|
    = devise_error_messages!

    table.company
      tbody
        tr
          td
            strong.label Required
          td.arrow_box
            | ステータス
          td
            = f.select(:status, [\
              ["SMS", "sms"],\
              ["LINE", "line"],\
              ["Recruitment", "recruitment"],\
              ["Interviewed", "interviewed"],\
              ["Interview NG", "interview_ng"],\
              ["Not Join", "not_join"],\
              ["NG", "ng"]\
            ], include_blank: "選択してください[Please select]")

    .tops-wrapper
      h2.headline 求職者入力
      - @user.errors.full_messages.each do |message|
        li = message

      table.company
        tbody
          tr
            td
              strong.label Required
            td.arrow_box
              | おなまえ [full_name]
            td
              = f.text_field :name, placeholder:"Taro Yamada"
          tr
            td
              strong.label Required
            td.arrow_box
              | せいべつ [gender]
            td
              = f.text_field :gender, placeholder:"Male"
          tr
            td
              strong.label Required
            td.arrow_box
              | でんわばんごう [Tel]
            td
              = f.text_field :tel, placeholder:"080-0000-0000"
          tr
            td
              strong.label Required
            td.arrow_box
              | メールアドレス [Mail]
            td
              = f.email_field :email, autofocus: true, autocomplete: "email", placeholder:"yamada@abc.com"
          tr
            td
              strong.label Required
            td.arrow_box
              | せいねんがっぴ [age]
            td
              = f.text_field :age, placeholder:"25才"
          tr
            td
              strong.label Required
            td.arrow_box
              | じゅうしょ[Address]
            td
              = f.text_field :address, placeholder:"東京都港区芝5-27-3 MBC・Aー9"

          - if admin_signed_in?
            tr
              td
                strong.label Required
              td.arrow_box
                | 転居はできますか？[Can I move to a different prefecture?]
              td
                = f.text_field :change_the_address
            tr
              td
                strong.label Required
              td.arrow_box
                | 車の種類
              td
                = f.text_field :car
            tr
              td
                strong.label Required
              td.arrow_box
                | 経験則
              td
                = f.text_field :experience
            tr
              td
                strong.label Required
              td.arrow_box
                | 希望職種
              td
                = f.text_field :hope_work
            tr
              td
                strong.label Required
              td.arrow_box
                | あなたはげんざいなんのしごとをしていますか？ [what_job_are_you_currently_doing?]
              td
                = f.text_field :past_business  
            tr
              td
                strong.label Required
              td.arrow_box
                | visaのしゅるいをおしえてください [please_tell_me_your_status_of_residence]
              td
                = f.select(:work_range, [\
                  ["特定技能ビザ[Specified Skilled Visa]","特定技能ビザ[Specified Skilled Visa]"],\
                  ["技術・人文・国際ビザ[Engineer/Humanities/International Visa]","技術・人文・国際ビザ[Engineer/Humanities/International Visa]"],\
                  ["永住ビザ [Permanent Resident Visa]","永住ビザ [Permanent Resident Visa]"],\
                  ["定住ビザ [Long-term resident visa]","定住ビザ [Long-term resident visa]"],\
                  ["配偶者ビザ [Spouse visa]","配偶者ビザ [Spouse visa]"],\
                  ["留学ビザ [Student visa]","留学ビザ [Student visa]"]\
                ], include_blank: "選択してください[Please select]")       
            tr
              td
                strong.label Required
              td.arrow_box
                | 日本に来て何年経ちますか？[How many years have you lived in Japan?]
              td
                = f.text_field :past_year
            tr
              td
                strong.label Required
              td.arrow_box
                | いつから働けますか？ [Since when can you job?]
              td
                = f.text_field :period
            tr
              td
                strong.label Required
              td.arrow_box
                | 日本語で会話できますか？[Can you speak Japanese conversation?]
              td
                = f.select(:speak_japanese, [\
                  ["漢字・ひらがな・カタカナができます","漢字・ひらがな・カタカナができます"],\
                  ["簡単な漢字・ひらがな・カタカナができます","簡単な漢字・ひらがな・カタカナができます"],\
                  ["漢字はできないが、ひらがな・カタカナができます","漢字はできないが、ひらがな・カタカナができます"],\
                  ["日本語の読み書きはできません","日本語の読み書きはできません"]\
                ], include_blank: "選択してください[Please select]")  
            tr
              td
                strong.label Required
              td.arrow_box
                | 備考
              td
                = f.text_area :remarks
            tr
              td
                strong.label Required
              td.arrow_box
                | LINE Account
              td
                = f.text_field :account_name

            
    - if admin_signed_in?
      h2.headline Work Information
      table.company
        colgroup
          col width="20%"
          col width="20%"
          col width="60%"
        tbody
          tr
            td
              strong.label Required
            td.arrow_box
              | ほうしゅうじょうけん[Reward Conditions]
            td
              = f.text_area :deliver
          tr
            td
              strong.label Required
            td.arrow_box
              | しゅっきんじょうけん[Working conditions]
            td
              = f.text_area :day_off

    table.company
      tbody
        tr
          td
            strong.label Required
          td.arrow_box
            | きんきゅうれんらくしゃ[Emergency Contact Person]
          td
            = f.text_field :emergency_name, placeholder:"Yoko Yamada"
        tr
          td
            strong.label Required
          td.arrow_box
            | かんれんせい[Relationship]
          td
            = f.text_field :emergency_relationships, placeholder:"Mother"
        tr
          td
            strong.label Required
          td.arrow_box
            | きんきゅうれんらくしゃばんごう[Emergency contact number]
          td
            = f.text_field :emergency_tel, placeholder:"+818010101010"
        tr
          td
            strong.label Required
          td.arrow_box
            | ぎんこうめい[Bank name]
          td
            = f.text_field :bank, placeholder:"三井住友銀行"
        tr
          td
            strong.label Required
          td.arrow_box
            | してんめい[Branch]
          td
            = f.text_field :branch, placeholder:"東京支店"
        tr
          td
            strong.label Required
          td.arrow_box
            | こうざばんごう[Account number]
          td
            = f.text_field :bank_number, placeholder:"0123456"
        tr
          td
            strong.label Required
          td.arrow_box
            | こうざめいぎ[Account name]
          td
            = f.text_field :bank_name, placeholder:"ヤマダ　タロウ"
        tr
          td
            strong.label Required
          td.arrow_box
            | めんしょしょう（おもて）[Driver's lisense[front]]
          td
            = f.file_field :image_1
        tr
          td
            strong.label Required
          td.arrow_box
            | めんしょしょう（うら）[Driver's lisense[back]]
          td
            = f.file_field :image_2
        tr
          td
            strong.label Required
          td.arrow_box
            | ざいりゅうきょかしょう（おもて）[Residence permit[front]]
          td
            = f.file_field :image_3
        tr
          td
            strong.label Required
          td.arrow_box
            | ざいりゅうきょかしょう（うら）[Residence permit[back]]
          td
            = f.file_field :image_4
        tr
          td
            strong.label Required
          td.arrow_box
            | ぎんこうかーど（おもて）[Bank card[front]]
          td
            = f.file_field :image_5
        tr
          td
            strong.label Required
          td.arrow_box
            | ぎんこうかーど（うら）[Bank card[back]]
          td
            = f.file_field :image_6
        tr
          td
            strong.label 必須
          td.arrow_box
            | パスワード[Password]
          td
            - if @minimum_password_length
              em = "(#{@minimum_password_length} characters minimum)"
            = f.password_field :password, autocomplete: "off"
        tr
          td.center colspan="3" = f.submit "同意して登録"

  br
  .center
    = render "users/shared/links"