br
table.list
  colgroup

  thead
    tr
      th User_name
      th Phone_number
      th email
      th Phase
      th Contract
      th Register_date
      th 
  tbody
    - @users.each do |user|
      tr
        td
          = user.name
        td
          = user.tel
        td
          = user.email
        td
          = user.line
        td
          = user&.contract_date
        td
          = user.created_at.strftime("%Y年%m月%d日")
        td
         = link_to "詳細を見る", user_path(user), class: "btn btn-success"
         -if admin_signed_in?
          = link_to "編集", edit_user_path(user), class: "btn btn-success"
          = link_to "削除", user_path(user), method: :delete, data: { confirm: '本当に削除しますか？' }, class: "btn btn-danger"
          
