h2 コメント編集

= form_for [@client, @comment] do |f|
  table.company[width="100%"]
    col[width="25%"]
    col[width="25%"]
    col[width="25%"]
    tbody
      tr
        th ステータス
        th 次回営業日
        th コメント

      tr
        td
          = f.select(:status, [
            ["商談", "商談"],
            ["見込低", "見込低"],
            ["見込中", "見込中"],
            ["見込高", "見込高"],
            ["契約", "契約"],
            ["NG", "NG"]
          ], include_blank: "選択してください")
        td
          = f.datetime_field :next
        td
          = f.text_area :body

      tr
        th[colspan="3"]
          .center
            = f.submit "更新する", class: "btn btn-primary"

= link_to "戻る", client_path(@client), class: "btn btn-secondary"