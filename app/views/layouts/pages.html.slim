doctype html
html lang="ja"
  head
    meta charset="UTF-8"
    meta name="viewport" content="width=device-width, initial-scale=1.0"
    = csrf_meta_tags

    link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
    link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@300;400;700&display=swap" rel="stylesheet"
    link href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" rel="stylesheet"
    = stylesheet_link_tag "pages", media: "all", "data-turbolinks-track": "reload"

    = display_meta_tags
    = favicon_link_tag "favicon.ico"

    - canonical_url = request.url
    link rel="canonical" href=canonical_url

    - if breadcrumbs.present?
      script type="application/ld+json"
        = raw(breadcrumb_list_json_ld)

  body
    - if breadcrumbs.present?
      nav.breadcrumbs aria-label="パンくず"
        = render_breadcrumbs separator: ' / '

    - if params[:sent] == '1'
      .flash-message.alert.alert-success role="alert"
        | 送信完了しました

      script
        |
          if (typeof gtag === 'function') {
            gtag('event', 'conversion', {
                'send_to': 'AW-10998015402/P0wGCMmaqZQcEKrLofwo',
                'value': 1.0,
                'currency': 'JPY'
            });
          }

    - if params[:error] == '1'
      .flash-message.alert.alert-danger role="alert"
        | 送信に失敗しました。入力内容をご確認ください。

    - flash.each do |type, message|
      - tag_class = (type == 'notice' ? 'success' : 'danger')
      div class="flash-message alert alert-#{tag_class}" role="alert"
        = message

    = yield

    = render "layouts/footer"

    = javascript_include_tag "pages", "data-turbolinks-track": "reload"
