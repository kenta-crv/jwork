- desk_page = controller_name == "users" && %w[index show edit].include?(action_name)
- auth_page = %w[sessions passwords].include?(controller_name) || (controller_name == "registrations" && action_name == "new") || (controller_name == "clients" && action_name == "mypage")
- jobs_page = controller_name == "recruits" && %w[index show new edit import].include?(action_name)
- html_class = []
- html_class << "auth-html" if desk_page || auth_page
- html_class << "jobs-html" if jobs_page
- body_class = []
- body_class << "auth-body" if desk_page || auth_page
- body_class << "jobs-body" if jobs_page
doctype html
html class=html_class.join(" ")
  head
    = render 'layouts/head'
  body class=body_class.join(" ")
    - unless auth_page
      header
        - unless desk_page || jobs_page
          .row
            .col-xs-2
              -if request.path == "/zero"
                = link_to "/zero"
                  =image_tag "rogo2.webp", width: "220px", class:"header-image", alt:"株式会社Ri-Plus『アポ匠ロゴ』"
              -elsif request.path == "/free"
                = link_to "/feee"
                  =image_tag "rogo3.webp", width: "220px", class:"header-image", alt:"株式会社Ri-Plus『アポ匠ロゴ』"
              -else
                = link_to "/"
                  =image_tag "rogo.webp", width: "220px", class:"header-image"
            .col-xs-8

        - unless jobs_page
          .row.navi
            .col-xs-12.center
              br/
              br/
              p.notice
                = notice
              p.alert
                = alert
      - if jobs_page
        - if notice.present?
          p.jobs-flash.jobs-flash--notice = notice
        - if alert.present?
          p.jobs-flash.jobs-flash--alert = alert
    main
      - unless jobs_page || auth_page
        .bread
          = render_breadcrumbs separator: ' > '
        br/
        br/
      = yield
    - unless jobs_page || auth_page
      br/
      br/
