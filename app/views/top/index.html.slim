.jw-gateway
  .jw-gateway__brand aria-label="J Work"
    = image_tag 'rogo.webp', alt: 'J Work', class: 'jw-gateway__brand-logo'

  p.jw-gateway__tagline
    | 国境をこえて、はたらく未来をつくる
    span.jw-gateway__tagline-line aria-hidden="true"

  .jw-gateway__intro
    h1.jw-gateway__title あなたはどちらですか？
    span.jw-gateway__title-accent aria-hidden="true"
    p.jw-gateway__lead PEOPLE CONNECT A BRIGHTER TOMORROW

  = image_tag 'jwork-city-skyline.png', class: 'jw-gateway__city', alt: '', aria: { hidden: true }

  .jw-gateway__floor aria-hidden="true"

  svg.jw-gateway__word-shadow.jw-gateway__word-shadow--cast viewBox="0 0 1672 590" preserveAspectRatio="none" aria-hidden="true" focusable="false"
    defs
      linearGradient id="jw-ground-shadow-gradient" x1="0%" y1="100%" x2="0%" y2="0%"
        stop offset="0%" stop-color="#123558" stop-opacity="0.30"
        stop offset="40%" stop-color="#426b91" stop-opacity="0.12"
        stop offset="100%" stop-color="#6d97b6" stop-opacity="0"
    g transform="translate(0 590) scale(1 -1)"
      text x="0" y="570" textLength="1672" lengthAdjust="spacingAndGlyphs" fill="url(#jw-ground-shadow-gradient)" JWORK

  svg.jw-gateway__word-shadow.jw-gateway__word-shadow--contact viewBox="0 0 1672 590" preserveAspectRatio="none" aria-hidden="true" focusable="false"
    g transform="translate(0 590) scale(1 -1)"
      text x="0" y="570" textLength="1672" lengthAdjust="spacingAndGlyphs" JWORK

  svg.jw-gateway__wordmark viewBox="0 0 1672 590" preserveAspectRatio="none" aria-hidden="true" focusable="false"
    defs
      linearGradient id="jw-letter-surface-gradient" x1="0%" y1="0%" x2="100%" y2="100%"
        stop offset="0%" stop-color="#0b2c53"
        stop offset="45%" stop-color="#062344"
        stop offset="78%" stop-color="#041c35"
        stop offset="100%" stop-color="#021329"
    text x="0" y="570" textLength="1672" lengthAdjust="spacingAndGlyphs" fill="url(#jw-letter-surface-gradient)" JWORK

  .jw-gateway__cast.jw-gateway__cast--left aria-hidden="true"
  .jw-gateway__cast.jw-gateway__cast--right aria-hidden="true"
  .jw-gateway__cast.jw-gateway__cast--people-left aria-hidden="true"
  .jw-gateway__cast.jw-gateway__cast--people-right aria-hidden="true"

  section.jw-gateway__portal.jw-gateway__portal--jobseekers aria-labelledby="jw-jobseekers-title"
    = image_tag 'jwork-portal-left.png', class: 'jw-gateway__portal-image', alt: ''

    = image_tag 'jwork-jobseekers.png', class: 'jw-gateway__people jw-gateway__people--jobseekers', alt: '仕事を探している外国人の男女'

    .jw-gateway__portal-copy
      h2.jw-gateway__portal-title id="jw-jobseekers-title"
        span.jw-gateway__title-line 仕事を探している
        strong.jw-gateway__title-line 外国人の方

      p.jw-gateway__portal-en
        | FOR FOREIGN JOB SEEKERS

      = link_to recruits_path, class: 'jw-gateway__button' do
        span.jw-gateway__button-label 求人を見る
        span.jw-gateway__button-arrow aria-hidden="true" →

  section.jw-gateway__portal.jw-gateway__portal--business aria-labelledby="jw-business-title"
    = image_tag 'jwork-portal-right.png', class: 'jw-gateway__portal-image', alt: ''

    = image_tag 'jwork-business-team.png', class: 'jw-gateway__people jw-gateway__people--business', alt: '外国人材の採用について話す企業担当者'

    .jw-gateway__portal-copy
      h2.jw-gateway__portal-title id="jw-business-title"
        span.jw-gateway__title-line 外国人材を探している
        strong.jw-gateway__title-line 企業の方

      p.jw-gateway__portal-en
        | FOR COMPANIES SEEKING GLOBAL TALENT

      = link_to foregin_staffing_path, class: 'jw-gateway__button' do
        span.jw-gateway__button-label
          span.jw-gateway__button-label-part 企業向けサービス
          span.jw-gateway__button-label-part を見る
        span.jw-gateway__button-arrow aria-hidden="true" →

  p.jw-gateway__side-copy
    | ともに、
    br
    | もっと広い世界へ
    span.jw-gateway__side-line aria-hidden="true"