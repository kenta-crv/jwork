    .sp-company
      .sp-company-inner
        h2 Company
        .sp-table
          .sp-row
            .sp-th 会社名
            .sp-td 株式会社セールスプロ
          .sp-row
            .sp-th 代表取締役
            .sp-td 奥山　健太
          .sp-row
            .sp-th 資本金
            .sp-td 5,000,000円
          .sp-row
            .sp-th 所在地
            .sp-td 東京都港区芝5-27-3 MBC・Aー9