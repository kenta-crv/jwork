.category-wrapper
  h2.headline = "求人一覧"
  = link_to "日本語", "/top/recruit", class:"btn btn-primary"
  = link_to "ひらがな", "/top/recruit_jp", class:"btn btn-primary"
  = link_to "ENGLISH", "/top/recruit_en", class:"btn btn-primary"          
  = link_to "計算[Calculation]", "/top/calculation", class:"btn btn-primary"          

.container
  .calculator
    h2 報酬(ほうしゅう)[Reward] 自動(じどう)[Automatic] 計算(けいさん)[Calculation] ツール[Tool]

    .form-group
      label 配送(はいそう)[Delivery] 単価(たんか)[Unit Price]（円[JPY]）
      input#unit_price.form-control type="number" value="130"

    .form-group
      label 配送(はいそう)[Delivery] 個数(こすう)[Quantity]
      input#quantity.form-control type="number" value="135"

    .form-group
      label 日数(にっすう)[Days]
      input#days.form-control type="number" value="25"

    h3 経費(けいひ)[Expenses]
    .form-group
      label 車レンタル代(しゃレンタルだい)[Car Rental]（円[JPY]）
      input#rental.form-control type="number" value="25000"
    .form-group
      label ガソリン代(ガソリンだい)[Gasoline]（円[JPY]）
      input#gas.form-control type="number" value="25000"
    .form-group
      label 保険代(ほけんだい)[Insurance]（円[JPY]）
      input#insurance.form-control type="number" value="1500"

    .result-box
      p
        strong 収益(しゅうえき)[Profit]：
        span#net_income.highlight 0
        | 円[JPY]

script
  |
    $(document).on('turbolinks:load', function() {
      var unitPriceInput = $('#unit_price');
      var quantityInput = $('#quantity');
      var daysInput = $('#days');

      var rentalInput = $('#rental');
      var gasInput = $('#gas');
      var insuranceInput = $('#insurance');

      var totalRewardEl = $('#total_reward');
      var totalExpenseEl = $('#total_expense');
      var netIncomeEl = $('#net_income');

      function calculate() {
        var unitPrice = parseFloat(unitPriceInput.val()) || 0;
        var quantity = parseFloat(quantityInput.val()) || 0;
        var days = parseFloat(daysInput.val()) || 0;

        var rental = parseFloat(rentalInput.val()) || 0;
        var gas = parseFloat(gasInput.val()) || 0;
        var insurance = parseFloat(insuranceInput.val()) || 0;

        var totalReward = unitPrice * quantity * days;
        var totalExpense = rental + gas + insurance;
        var netIncome = totalReward - totalExpense;

        totalRewardEl.text(totalReward.toLocaleString());
        totalExpenseEl.text(totalExpense.toLocaleString());
        netIncomeEl.text(netIncome.toLocaleString());
      }

      $('#unit_price, #quantity, #days, #rental, #gas, #insurance').on('input', calculate);

      // 初期計算
      calculate();
    });
