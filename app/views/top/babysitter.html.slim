- set_meta_tags title: 'ベビーシッター・キッズケア・お子様の見守りなら『J Work』'
    - set_meta_tags description: '安心・安全なベビーシッター・キッズケアなら『J Work』。経験豊富なスタッフが、大切なお子様を心を込めてお預かりします。'

    section.hero-main-section.position-relative(style="background-image: url(#{asset_path('housekeeping-image.png')});")
      .container
        .row.align-items-center.gy-4
          .col-lg-6
            .hero-main-left
              .hero-main-top
                button.hero-main-top-btn
                  | ベビーシッター・キッズケアをお探しの方へ
              h1.hero-main-title.mt-4
                span.noto
                  | 大切なお子様を愛情たっぷりにお預かり
              h2.hero-main-subtitle.mt-3
                span.noto
                  | 信頼のシッター派遣なら『株式会社J Work』
              .d-flex.align-items-center.mt-4.hero-main-badges.gap-3
                button.hero-main-badge
                  |  ✓ 安心の安全管理
                p.hero-main-badge-text
                  | 救急救命講習や研修を修了したプロが対応！
              .d-flex.align-items-center.mt-4.hero-main-badges.gap-3
                button.hero-main-badge
                  |  ✓ 24時間・365日
                p.hero-main-badge-text
                  | 急な残業や夜間のご予定でも全国どこでも対応OK！
              .d-flex.align-items-center.mt-4.hero-main-badges.gap-3
                button.hero-main-badge
                  |  ✓ 多彩なケア内容
                p.hero-main-badge-text
                  | 送迎から学習サポート、遊び相手まで幅広く対応！
          .col-lg-6
            .hero-main-right.p-4.rounded-3
              h3.hero-main-trial.text-center
                | ＼まずはご相談ください！／
              = form_with model: @contract, url: contracts_path, local: true, html: { id: "hero-main-top", class: "hero-main-form mt-3 p-4 rounded-3" } do |f|
                .row.g-3
                  .col-12
                    label.form-label.hero-main-label
                      | お名前（または保護者名） 
                      span.required-badge
                        | 必須
                    = f.text_field :company, class: "form-control hero-main-input", placeholder: "山田太郎", required: true
                  .col-12
                    label.form-label.hero-main-label
                      | ご連絡者様名（ご家族の場合）
                      span.required-badge
                        | 必須
                    = f.text_field :name, class: "form-control hero-main-input", placeholder: "山田太郎", required: true
                  .col-12
                    label.form-label.hero-main-label
                      | 電話番号 
                      span.required-badge
                        | 必須
                    = f.telephone_field :tel, class: "form-control hero-main-input", placeholder: "050-1234-5678", required: true
                  .col-12
                    label.form-label.hero-main-label
                      | ご住所（派遣先）
                      span.required-badge
                        | 必須
                    = f.text_field :address, class: "form-control hero-main-input", placeholder: "東京都東京市東京町1-1-1東京ビル111", required: true
                  .col-12
                    label.form-label.hero-main-label
                      | メールアドレス 
                      span.required-badge
                        | 必須
                    = f.email_field :email, class: "form-control hero-main-input", placeholder: "test@example.com", required: true
                  .col-12
                    label.form-label.hero-main-label
                      | 備考・要望 
                      span.required-badge
                        | 任意
                    = f.text_area :message, class: "form-control hero-main-input", placeholder:"（例）お子様の年齢や希望の保育内容、時間帯など"
                  .col-12
                    = f.submit "まずは無料で見積から", class: "btn hero-main-submit w-100"
      .hero-main-overlay
